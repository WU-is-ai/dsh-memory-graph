{
  "name": "dsh-memory-graph",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "把 mnemon 记忆库画成可导航星图：权重衰减 + 实体关系，只读不改库 / Memory star map for mnemon",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
