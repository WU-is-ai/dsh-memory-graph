{
  "name": "dsh-memory-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Memory star map: draws the mnemon memory store as a navigable constellation, with weighted decay and entity relations",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
